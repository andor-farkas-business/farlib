@model FarLibPages.ViewComponents.Models.Card

@{
    int indexOfPeriod = Model.Text.IndexOf('.');
    int descriptionLength = Model.Text.Length;
    string descriptionEnd = string.Empty;
    if (indexOfPeriod != -1 && descriptionLength > indexOfPeriod + 1) // we have more than a single complete sentence
    {
        descriptionLength = indexOfPeriod;
        descriptionEnd = "...";
    }
}

<div class="col">
    <div class="card border-info">
        <a asp-page="@Model.ButtonPage" asp-route-id="@Model.ButtonRouteId">
            <img src="@Model.ImageSource" class="card-img-top" alt="@Model.ImageAlt"/>
        </a>
        <div class="card-body">
            <h5 class="card-title text-center">
                <a asp-page="@Model.ButtonPage" asp-route-id="@Model.ButtonRouteId">@Model.Title</a>
            </h5>
            @if (!string.IsNullOrWhiteSpace(Model.Text))
            {
                <p class="card-text pb-1 px-2">@Model.Text.Substring(0, descriptionLength)@descriptionEnd</p>
            }
        </div>
    </div>
</div>